# ---------------------------------------------------------------------------
# AI provider (server-side only — never prefix these with NEXT_PUBLIC_)
# ---------------------------------------------------------------------------
# Which provider implementation to use:
#   "anthropic"   - Claude API through the Anthropic SDK, billed per token (needs ANTHROPIC_API_KEY)
#   "claude-code" - Claude Agent SDK using the Claude Code login on this computer (your Claude
#                   subscription). Personal, local use only. Run `claude` once to log in.
#   "demo"        - scripted, clearly-labelled placeholder (development only)
AI_PROVIDER=anthropic
# Read by the official Anthropic SDK. Get one at https://platform.claude.com/
ANTHROPIC_API_KEY=
# Model id. Any Claude model id works; default is claude-opus-5-5.
AI_MODEL=claude-opus-5-5
# Reasoning effort: low | medium | high | xhigh | max | off (off = don't send the parameter)
AI_EFFORT=medium
# Max tokens per reply (includes the model's internal reasoning).
AI_MAX_OUTPUT_TOKENS=16000
# Approximate token budget for conversation history sent with each request.
AI_CONTEXT_MAX_TOKENS=24000
# Request timeout in milliseconds.
AI_TIMEOUT_MS=120000
# Re-run safety-declined requests on Anthropic's recommended fallback model (supported models only).
AI_SERVER_FALLBACKS=true
# Per-user chat requests per minute (per server instance).
AI_RATE_LIMIT_PER_MINUTE=12

# ---------------------------------------------------------------------------
# Supabase (database + auth). Leave empty to run the single-user local mode.
# The anon key is public by design; Row Level Security protects the data.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Local mode (only used when Supabase is not configured)
# ---------------------------------------------------------------------------
# Where the JSON database and uploads are stored.
NOCTURNE_DATA_DIR=.data
# Local mode is refused in production builds unless this is "true".
NOCTURNE_ALLOW_LOCAL_MODE=false
